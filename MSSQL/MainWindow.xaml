<Window x:Class="MSSQL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:local="clr-namespace:MSSQL"
        mc:Ignorable="d"
        Closing="WindowClosing" 
        ResizeMode="CanMinimize"
        Title="MSSQL" Height="700" Width="1000" Background="#FF3E6FB3" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5.5*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>
        <Image Grid.Row="1" Grid.Column="1" x:Name="Logo"  Margin="0,23,0,0" HorizontalAlignment="Center" Height="141" VerticalAlignment="Top" Width="159" Source="Icon/SQL.png"/>
        <TabControl Grid.Row="1" Grid.Column="0" x:Name="LogRecord" HorizontalAlignment="Left" Height="175" VerticalAlignment="Top" Width="790" Background="#FFE6F0FF">
            <TabControl.Resources>
                <Style TargetType="RichTextBox">
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="IsReadOnly" Value="True" />
                    <Setter Property="DockPanel.Dock" Value="Bottom" />
                </Style>
                <Style TargetType="Paragraph">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FontSize" Value="16" />
                </Style>
            </TabControl.Resources>
            <TabItem Header="一般" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxGeneral" Background="#FF43B5BF"/>
            </TabItem>
            <TabItem Header="警告" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxWarning" Background="#FF43AABF"/>
            </TabItem>
            <TabItem Header="錯誤" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxError" Background="#FF43A0BF"/>
            </TabItem>
            <TabItem Header="除錯" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxDebug" Background="#FF4396BF"/>
            </TabItem>
        </TabControl>
        <TabControl Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="5,3,0,0" VerticalAlignment="Top" Height="478" Width="978" Background="#FFE6F0FF">
            <TabItem Header="主畫面" Style="{StaticResource BaseTabcontrol}">
                <Grid>
                    <GroupBox Style="{StaticResource BaseGroupBox}" Margin="4,44,754,42" Header="Show Information" FontSize="22" Foreground="Black" Background="Teal">
                        <WrapPanel Orientation="Horizontal">
                            <TextBox x:Name="Database_Name_ForShowInformation" Style="{StaticResource BaseTextBox}" Margin="36,12,0,0" Tag="Database Name" FontSize="14" Width="120" Height="43"/>
                            <TextBox x:Name="Table_Name_ForShowInformation" Style="{StaticResource BaseTextBox}" Margin="36,12,0,0" Tag="Table Name" FontSize="14" Width="120" Height="43"/>
                            <Button x:Name="Show_Database" Style="{StaticResource CircleButton}" Margin="10,12,0,0" FontSize="16" Height="80" Width="80" Click="Main_Btn_Click">
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap">Show<LineBreak/>Database</TextBlock>
                            </Button>
                            <Button x:Name="Show_Table" Style="{StaticResource CircleButton}" Margin="10,12,0,0" FontSize="16" Height="80" Width="80" Click="Main_Btn_Click">
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap">Show<LineBreak/>Table</TextBlock>
                            </Button>
                            <Button x:Name="Show_TableData" Style="{StaticResource CircleButton}" Margin="56,12,0,0" FontSize="16" Height="80" Width="80" Click="Main_Btn_Click">
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap">Show<LineBreak/>TableData</TextBlock>
                            </Button>


                        </WrapPanel>
                    </GroupBox>
                    <GroupBox Style="{StaticResource BaseGroupBox}" Margin="225,120,533,102" Header="Operate Database" FontSize="22" Foreground="Black" Background="Teal">
                        <WrapPanel>
                            <TextBox x:Name="Database_Name_ForOperateDatabase" Style="{StaticResource BaseTextBox}" Margin="36,12,0,0" Tag="Database Name" FontSize="14" Width="120" Height="43"/>
                            <Button x:Name="Create_Database" Style="{StaticResource CircleButton}" Margin="10,12,0,0" FontSize="16" Height="80" Width="80" Click="Main_Btn_Click">
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap">Create<LineBreak/>Database</TextBlock>
                            </Button>
                            <Button x:Name="Drop_Database" Style="{StaticResource CircleButton}" Margin="10,12,0,0" FontSize="16" Height="80" Width="80" Click="Main_Btn_Click">
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap">Drop<LineBreak/>Database</TextBlock>
                            </Button>
                        </WrapPanel>
                    </GroupBox>
                    <GroupBox Style="{StaticResource BaseGroupBox}" Margin="446,15,148,9" Header="Operate Table" FontSize="22" Foreground="Black" Background="Teal">
                        <WrapPanel>
                            <TextBox x:Name="Database_Name_ForOperateTable" Style="{StaticResource BaseTextBox}" Margin="38,8,0,0" Tag="Database Name" FontSize="14" Width="120" Height="43"/>
                            <TextBox x:Name="Table_Name_ForOperateTable" Style="{StaticResource BaseTextBox}" Margin="38,8,0,0" Tag="Table Name" FontSize="14" Width="120" Height="43"/>
                            <RichTextBox x:Name="Dialogue" Margin="6,8,0,0" Width="344" Height="120" Background="Beige" VerticalScrollBarVisibility="Auto">
                                <RichTextBox.Resources>
                                    <Style TargetType="Paragraph">
                                        <Setter Property="Margin" Value="0"/>
                                        <!-- 段落外距 0 -->
                                        <Setter Property="LineHeight" Value="12"/>
                                        <!-- 行高可依需求調整 -->
                                    </Style>
                                </RichTextBox.Resources>
                            </RichTextBox>
                            <Button x:Name="Create_Table" Style="{StaticResource CircleButton}" Margin="29,8,0,0" FontSize="16" Height="80" Width="80" Click="Main_Btn_Click">
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap">Create<LineBreak/>Table</TextBlock>
                            </Button>
                            <Button x:Name="Drop_Table" Style="{StaticResource CircleButton}" Margin="29,8,0,0" FontSize="16" Height="80" Width="80" Click="Main_Btn_Click">
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap">Drop<LineBreak/>Table</TextBlock>
                            </Button>
                            <Button x:Name="Insert_Data" Style="{StaticResource CircleButton}" Margin="29,8,0,0" FontSize="16" Height="80" Width="80" Click="Main_Btn_Click">
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap">Insert<LineBreak/>Data</TextBlock>
                            </Button>
                            <Button x:Name="Update_Data" Style="{StaticResource CircleButton}" Margin="65,8,0,0" FontSize="16" Height="80" Width="80" Click="Main_Btn_Click">
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap">Update<LineBreak/>Data</TextBlock>
                            </Button>
                            <Button x:Name="Delete_Data" Style="{StaticResource CircleButton}" Margin="65,8,0,0" FontSize="16" Height="80" Width="80" Click="Main_Btn_Click">
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap">Delete<LineBreak/>Data</TextBlock>
                            </Button>
                        </WrapPanel>
                    </GroupBox>
                    <TextBox x:Name="Server_Name" Style="{StaticResource BaseTextBox}" Margin="837,60,15,343" Tag="Server Name" FontSize="14" Width="120" Height="43"/>
                    <WrapPanel Margin="852,105,30,32">
                        <Button x:Name="Connet" Style="{StaticResource CircleButton}" Margin="5,17,0,0" Content="Connet" FontSize="16" Height="80" Width="80" Click="Main_Btn_Click"/>
                        <Button x:Name="Disconnet" Style="{StaticResource CircleButton}" Margin="5,17,0,0" Content="Disconnet" FontSize="16" Height="80" Width="80" Click="Main_Btn_Click"/>
                        <Button x:Name="Save_Config" Style="{StaticResource CircleButton}" Margin="5,17,0,0" FontSize="16" Height="80" Width="80" Click="Main_Btn_Click">
                            <TextBlock TextAlignment="Center" TextWrapping="Wrap">Save<LineBreak/>Config</TextBlock>
                        </Button>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="關於" Style="{StaticResource BaseTabcontrol}" PreviewMouseLeftButtonDown="About_Click"/>
        </TabControl>
    </Grid>
</Window>
